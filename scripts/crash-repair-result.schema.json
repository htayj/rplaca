{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "diagnosis",
    "changes",
    "validation",
    "recurrence_prevention"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["fixed", "blocked"]
    },
    "diagnosis": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "validation": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recurrence_prevention": {
      "type": "string"
    }
  }
}
