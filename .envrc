watch_file guix.scm
watch_file shell.nix

export RPLACA_QUICKLISP_SETUP="$PWD/.cache/home/quicklisp/setup.lisp"
export XDG_CACHE_HOME="$PWD/.cache"

mkdir -p "$XDG_CACHE_HOME/home/quicklisp"

if has guix && [ -f guix.scm ]; then
  eval "$(guix shell -f guix.scm --search-paths)"
elif has nix-shell && [ -f shell.nix ]; then
  use nix
else
  log_error "No supported environment manager found. Install Guix or Nix (with nix-shell)."
fi

# Claude Code CLI — needed for Claude Max subscription models (Sonnet/Opus)
if [ -x "$HOME/.nix-profile/bin/claude" ]; then
  PATH_add "$HOME/.nix-profile/bin"
fi
